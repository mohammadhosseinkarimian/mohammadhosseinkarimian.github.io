        phase_1 = 2 if phase_1 = 1 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_1 > 1 or (Action = calm or Action = harm_0)) and (Responder2.Action = load_1 or Responder3.Action = load_1);
        carrier_1 = 2 if phase_1 = 1 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_1 > 1 or (Action = calm or Action = harm_0)) and Responder2.Action = load_1;
        phase_1 = 3 if phase_1 = 2 and carrier_1 = 2 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_1 > 1 or (Action = calm or Action = harm_0)) and Responder2.Action = unload_1;
        loc_1 = 0 if phase_1 = 2 and carrier_1 = 2 and Responder2.Action = move_0;
