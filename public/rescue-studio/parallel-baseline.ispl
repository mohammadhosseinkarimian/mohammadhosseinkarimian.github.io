        clock = 12 if clock = 13 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3);
        clock = 13 if clock = 14 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3);
        hazard = 0 if hazard = 1 and (Action = harm_0 or Action = harm_1);
    end Evolution
end Agent

