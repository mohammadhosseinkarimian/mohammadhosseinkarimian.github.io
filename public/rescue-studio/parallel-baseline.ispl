Semantics=SingleAssignment;

Agent Environment
    Obsvars:
        pos_0: 0 .. 7;
        pos_1: 0 .. 7;
        pos_2: 0 .. 7;
        pos_3: 0 .. 7;
        pos_4: 0 .. 7;
        pos_5: 0 .. 7;
        phase_0: 0 .. 3;
        carrier_0: 0 .. 6;
        health_0: 0 .. 4;
        loc_0: 0 .. 7;
        phase_1: 0 .. 3;
        carrier_1: 0 .. 6;
        health_1: 0 .. 4;
        loc_1: 0 .. 7;
        clock: 0 .. 14;
        hazard: 0 .. 1;
        blocked_0: boolean;
        blocked_1: boolean;
    end Obsvars
    Actions = {calm, harm_0, harm_1};
    Protocol:
        clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3): {calm};
        clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and hazard > 0 and phase_0 < 3: {harm_0};
        clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and hazard > 0 and phase_1 < 3: {harm_1};
        Other: {calm};
    end Protocol
    Evolution:
        pos_0 = 0 if Responder0.Action = move_0;
        pos_0 = 1 if Responder0.Action = move_1;
        pos_0 = 2 if Responder0.Action = move_2;
        pos_0 = 3 if Responder0.Action = move_3;
        pos_0 = 4 if Responder0.Action = move_4;
        pos_0 = 5 if Responder0.Action = move_5;
        pos_0 = 6 if Responder0.Action = move_6;
        pos_0 = 7 if Responder0.Action = move_7;
        pos_1 = 0 if Responder1.Action = move_0;
        pos_1 = 1 if Responder1.Action = move_1;
        pos_1 = 2 if Responder1.Action = move_2;
        pos_1 = 3 if Responder1.Action = move_3;
        pos_1 = 4 if Responder1.Action = move_4;
        pos_1 = 5 if Responder1.Action = move_5;
        pos_1 = 6 if Responder1.Action = move_6;
        pos_1 = 7 if Responder1.Action = move_7;
        pos_2 = 0 if Responder2.Action = move_0;
        pos_2 = 1 if Responder2.Action = move_1;
        pos_2 = 2 if Responder2.Action = move_2;
        pos_2 = 3 if Responder2.Action = move_3;
        pos_2 = 4 if Responder2.Action = move_4;
        pos_2 = 5 if Responder2.Action = move_5;
        pos_2 = 6 if Responder2.Action = move_6;
        pos_2 = 7 if Responder2.Action = move_7;
        pos_3 = 0 if Responder3.Action = move_0;
        pos_3 = 1 if Responder3.Action = move_1;
        pos_3 = 2 if Responder3.Action = move_2;
        pos_3 = 3 if Responder3.Action = move_3;
        pos_3 = 4 if Responder3.Action = move_4;
        pos_3 = 5 if Responder3.Action = move_5;
        pos_3 = 6 if Responder3.Action = move_6;
        pos_3 = 7 if Responder3.Action = move_7;
        pos_4 = 0 if Responder4.Action = move_0;
        pos_4 = 1 if Responder4.Action = move_1;
        pos_4 = 2 if Responder4.Action = move_2;
        pos_4 = 3 if Responder4.Action = move_3;
        pos_4 = 4 if Responder4.Action = move_4;
        pos_4 = 5 if Responder4.Action = move_5;
        pos_4 = 6 if Responder4.Action = move_6;
        pos_4 = 7 if Responder4.Action = move_7;
        pos_5 = 0 if Responder5.Action = move_0;
        pos_5 = 1 if Responder5.Action = move_1;
        pos_5 = 2 if Responder5.Action = move_2;
        pos_5 = 3 if Responder5.Action = move_3;
        pos_5 = 4 if Responder5.Action = move_4;
        pos_5 = 5 if Responder5.Action = move_5;
        pos_5 = 6 if Responder5.Action = move_6;
        pos_5 = 7 if Responder5.Action = move_7;
        blocked_0 = false if (Responder4.Action = clear_0 or Responder5.Action = clear_0);
        blocked_1 = false if (Responder4.Action = clear_1 or Responder5.Action = clear_1);
        health_0 = 0 if health_0 = 1 and Action = harm_0;
        health_0 = 1 if health_0 = 2 and Action = harm_0;
        health_0 = 2 if health_0 = 3 and Action = harm_0;
        health_0 = 3 if health_0 = 4 and Action = harm_0;
        phase_0 = 1 if phase_0 = 0 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_0 > 1 or (Action = calm or Action = harm_1)) and (Responder0.Action = rescue_0 or Responder1.Action = rescue_0);
        phase_0 = 2 if phase_0 = 1 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_0 > 1 or (Action = calm or Action = harm_1)) and (Responder2.Action = load_0 or Responder3.Action = load_0);
        carrier_0 = 2 if phase_0 = 1 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_0 > 1 or (Action = calm or Action = harm_1)) and Responder2.Action = load_0;
        phase_0 = 3 if phase_0 = 2 and carrier_0 = 2 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_0 > 1 or (Action = calm or Action = harm_1)) and Responder2.Action = unload_0;
        loc_0 = 0 if phase_0 = 2 and carrier_0 = 2 and Responder2.Action = move_0;
        loc_0 = 1 if phase_0 = 2 and carrier_0 = 2 and Responder2.Action = move_1;
        loc_0 = 2 if phase_0 = 2 and carrier_0 = 2 and Responder2.Action = move_2;
