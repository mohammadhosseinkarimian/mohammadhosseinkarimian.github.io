        loc_1 = 7 if phase_1 = 2 and carrier_1 = 2 and Responder2.Action = move_7;
        carrier_1 = 3 if phase_1 = 1 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_1 > 1 or (Action = calm or Action = harm_0)) and Responder3.Action = load_1 and (Responder2.Action = stay or Responder2.Action = move_0 or Responder2.Action = move_1 or Responder2.Action = move_2 or Responder2.Action = move_3 or Responder2.Action = move_4 or Responder2.Action = move_5 or Responder2.Action = move_6 or Responder2.Action = move_7 or Responder2.Action = load_0 or Responder2.Action = unload_0 or Responder2.Action = unload_1);
        phase_1 = 3 if phase_1 = 2 and carrier_1 = 3 and clock > 0 and (health_0 > 0 and health_1 > 0) and (phase_0 < 3 or phase_1 < 3) and (health_1 > 1 or (Action = calm or Action = harm_0)) and Responder3.Action = unload_1;
        loc_1 = 0 if phase_1 = 2 and carrier_1 = 3 and Responder3.Action = move_0;
        loc_1 = 1 if phase_1 = 2 and carrier_1 = 3 and Responder3.Action = move_1;
        loc_1 = 2 if phase_1 = 2 and carrier_1 = 3 and Responder3.Action = move_2;
